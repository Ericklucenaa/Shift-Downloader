{
  "manifest_version": 3,
  "name": "SHIFT Download Manager",
  "short_name": "SHIFT",
  "version": "0.3.0",
  "description": "Envia links e downloads para o SHIFT Download Manager.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SHIFT",
    "default_icon": {
      "32": "icon-32.png",
      "64": "icon-64.png"
    }
  },
  "icons": {
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "magnet.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}