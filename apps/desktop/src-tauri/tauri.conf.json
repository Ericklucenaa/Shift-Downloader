{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shift Downloader",
  "mainBinaryName": "shift-desktop",
  "version": "0.5.2",
  "identifier": "app.shift.downloads",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shift Downloader",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Gerenciador de downloads",
    "externalBin": [
      "binaries/aria2c"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../../../docs/third-party/NOTICE.txt",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish"
        ],
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "tools/yt-dlp.exe": "tools/yt-dlp.exe",
      "tools/ffmpeg/*": "tools/ffmpeg/",
      "../../browser-extension/*": "browser-extension/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMzlGOUMwQzlFRkUzMjAKUldRZzQrL0p3UGs1TUlyRkdGZ2dPeTlSdnFXN1hYUzd2V3NvMGtEY0dBWUxjYmFUTDNkLzdvRHoK",
      "endpoints": [
        "https://github.com/Ericklucenaa/Shift-Downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
